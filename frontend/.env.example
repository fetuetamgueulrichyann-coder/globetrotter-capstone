# URL du Gateway backend (Phase 2 microservices)
VITE_API_URL=http://localhost:8000

# Messagerie temps réel : connexion WebSocket directe à messaging-service
# (le Gateway ne relaie pas les connexions WebSocket, voir docker-compose.yml)
VITE_MESSAGING_WS_URL=http://localhost:8000

# Aucune clé API requise : la carte utilise OpenStreetMap (gratuit, libre, sans inscription).

# Liens affiliés (commission sur réservations) — laisser vide tant que tu
# n'as pas de compte Booking.com Affiliate Partner / Agoda Affiliate.
VITE_BOOKING_AID=
VITE_AGODA_CID=

# Client ID Google Cloud Console (Identity Services) — doit correspondre
# EXACTEMENT au domaine déclaré dans "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=857814601767-2d36ai64gmn8d5qtraeq6f9do7cv3fbi.apps.googleusercontent.com

# Serveur TURN (appels audio/vidéo). Laisse vide en développement local —
# le code se contente alors du STUN public (suffisant en local).
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
