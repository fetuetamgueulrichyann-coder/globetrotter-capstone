# Lancement local (python run.py) : localhost. Avec docker-compose, remplace par les noms de service (ex: http://user-service:5001, http://rabbitmq:5672).
FLASK_ENV=development
PORT=5001
JWT_SECRET=change_this_shared_secret_across_all_services
JWT_EXPIRES_IN_HOURS=168
CORS_ORIGIN=http://localhost:8000
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
INTERNAL_API_KEY=change_this_internal_key
DATABASE_URL=postgresql://mboatrip:change_this_password@localhost:5432/mboatrip
ADMIN_EMAIL=admin@gmail.com
ADMIN_SEED_PASSWORD=change_me_before_first_deploy
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
