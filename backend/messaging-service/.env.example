# Lancement local (python run.py) : localhost. Avec docker-compose, remplace par les noms de service (ex: http://user-service:5001).
FLASK_ENV=development
PORT=5005
JWT_SECRET=change_this_shared_secret_across_all_services
CORS_ORIGIN=http://localhost:8000
INTERNAL_API_KEY=change_this_shared_internal_key
USER_SERVICE_URL=http://localhost:5001
DATABASE_URL=postgresql://mboatrip:change_this_password@localhost:5432/mboatrip
