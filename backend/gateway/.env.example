# Lancement local (python run.py) : localhost. Avec docker-compose, remplace par les noms de service (ex: http://user-service:5001, http://rabbitmq:5672).
FLASK_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
USER_SERVICE_URL=http://localhost:5001
ITINERARY_SERVICE_URL=http://localhost:5002
RECOMMENDATION_SERVICE_URL=http://localhost:5003
SOCIAL_SERVICE_URL=http://localhost:5004
MESSAGING_SERVICE_URL=http://localhost:5005
