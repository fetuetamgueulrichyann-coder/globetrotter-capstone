# Copie ce fichier en backend/.env (jamais commité) et remplis de vraies
# valeurs. Ce fichier est lu uniquement par Docker Compose lui-même (pas par
# les apps Flask), pour les variables utilisées directement dans
# docker-compose.yml.

# Préfixe le réseau et les volumes Docker créés, pour ne jamais entrer en
# conflit avec d'autres projets sur le même VPS partagé.
COMPOSE_PROJECT_NAME=mboatrip_yann

# Mot de passe PostgreSQL — génère une valeur forte et unique.
POSTGRES_PASSWORD=change_this_password

# Serveur TURN (appels audio/vidéo, voir le service "turn" dans
# docker-compose.yml). TURN_EXTERNAL_IP doit être l'IP publique du VPS.
TURN_USERNAME=mboatrip
TURN_PASSWORD=change_this_password_too
TURN_EXTERNAL_IP=203.0.113.10
